# Copy this file to ".env.local" and fill in the values. (.env.local is git-ignored.)

# --- Required: Supabase (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret. Server-only; never expose it or give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Optional: rate limiting with Upstash Redis (console.upstash.com → REST API) ---
# Without these, limits fall back to in-memory counters per serverless instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional: Discord bot (discord.com/developers/applications) ---
# DISCORD_PUBLIC_KEY=   # General Information → Public Key (signature verification)
# DISCORD_APP_ID=       # General Information → Application ID
# DISCORD_BOT_TOKEN=    # Bot → Reset Token (secret)
# DISCORD_DEFAULT_GID=  # Room id (Supabase groups.id) the bot serves by default
# DISCORD_GUILD_ID=     # Test server id, so commands update instantly instead of globally

# --- Optional: screenshot reading with GPT-4o via GitHub Models ---
# GITHUB_TOKEN=

# --- Optional: Riot API fallback for rank lookup ---
# RIOT_API_KEY=
