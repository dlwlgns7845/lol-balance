# 이 파일을 복사해서 ".env.local" 로 만들고 값을 채우세요. (.env.local 은 git에 안 올라감)
# Supabase 대시보드 → Project Settings → API 에서 복사.

SUPABASE_URL=https://your-project-ref.supabase.co
# service_role 키는 시크릿! 서버에서만 사용, 절대 공개/커밋 금지. NEXT_PUBLIC_ 접두사 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# (Phase C) AI 스샷 판독용 비전 모델 키 — 나중에
# ANTHROPIC_API_KEY=

# (선택) 레이트리밋 하드가드 — Upstash Redis (console.upstash.com → REST API 탭에서 복사).
# 없으면 인메모리 폴백으로 동작(서버리스 인스턴스별 speed bump). 공개 배포 시 설정 권장.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
